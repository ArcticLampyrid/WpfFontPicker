<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageId>ALampy.XamlFontPicker.Avalonia</PackageId>
    <Authors>ALampy</Authors>
    <Company>ALampy</Company>
    <Product>ALampy.XamlFontPicker.Avalonia</Product>
    <RepositoryUrl>https://github.com/ArcticLampyrid/XamlFontPicker</RepositoryUrl>
    <RootNamespace>ALampy.XamlFontPicker.Avalonia</RootNamespace>
    <AssemblyName>ALampy.XamlFontPicker.Avalonia</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Avalonia;Font;FontDialog;FontPicker;XAML</PackageTags>
    <PackageDescription>A library providing common FontPicker (control) and FontDialog for Avalonia applications.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
