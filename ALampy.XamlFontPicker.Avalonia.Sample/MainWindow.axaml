<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="ALampy.XamlFontPicker.AvaloniaSample.MainWindow"
        mc:Ignorable="d"
        Title="Avalonia Sample - FontPicker"
        Width="800"
        Height="450">
  <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Avalonia FontPicker Sample" FontSize="24" Margin="0,0,0,20"/>
    <TextBlock Text="Hello from Avalonia 11!" FontSize="16"/>
  </StackPanel>
</Window>
